# Frontend Application Configuration
VITE_APP_TITLE="Chennai Startup & Jobs Map"
VITE_APP_DESCRIPTION="Interactive ecosystem map and job directory for startups in Chennai"
VITE_DEFAULT_MAP_LAT=13.0827
VITE_DEFAULT_MAP_LNG=80.2707
VITE_DEFAULT_MAP_ZOOM=12
VITE_API_BASE_URL="http://localhost:5241/api/v1"

# Map Configuration (Keyless OpenStreetMap - No Commercial API Key Required)
# Tiles are served from https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png with Leaflet Marker Clustering

# Backend Database Configuration (PostgreSQL / EF Core)
# If PostgreSQL is not configured, the API automatically falls back to in-memory mode for development and testing.
ConnectionStrings__PostgreSql="Host=localhost;Port=5432;Database=chennaistartupjobs;Username=postgres;Password=postgres"

# Backend Security & JWT Token Issuer
Jwt__SecretKey="ChennaiStartupJobsMapSuperSecretEnterpriseSigningKey2026"
Jwt__Issuer="ChennaiStartupJobsMap"
Jwt__Audience="ChennaiStartupJobsMapAudience"

